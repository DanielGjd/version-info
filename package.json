  "scripts": {
    "ng": "ng",
    "test": "jest --silent --coverage",
    "lint": "ng lint",
    "ci:lint:check": "ng lint",
    "serve": "ng serve webapp",
    "test:foreground": "jest --config=jest.config.js --ci --coverage --unhandled-rejections=warn --detectOpenHandles",
    "ci:build:production": "ng build webapp --configuration=production",
    "ci:build:old": "ng build webapp --configuration=old",
    "ci:build:dev": "ng build webapp",
    "ci:prettier:check": "prettier -c \"./projects/**/*.{html,ts,css,scss,json}\"",
    "release": "standard-version -n",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "prettier:fix": "prettier --write \"./projects/**/*.{html,ts,css,scss,json}\"",
    "prepare": "husky install",
    "gen-i18n": "ng run i18n:translate-export && ng run i18n:translate-generate-map && ng run i18n:translate-import",
    "translate-export": "ng run i18n:translate-export",
    "translate-import": "ng run i18n:translate-import",
    "translate-generate-map": "ng run i18n:translate-generate-map",
    "ci:e2e": "concurrently --success first --kill-others \"npm run serve\" \"npm run e2e\"",
    "e2e": "cypress run --headless --browser chrome",
    "e2e:open": "cypress open",
    "local:e2e": "concurrently --success first --kill-others \"npm run serve\" \"npm run e2e:open\"",
    "ci:package:version:set": "bash ./scripts/set-package-version.sh",
    "ci:generate-license-report": "ng run webapp:license"
  },
  "private": true,
